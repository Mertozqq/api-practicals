PORT=3000
HOST=127.0.0.1
GRPC_ADDRESS=127.0.0.1:50051
# Set true for a separately launched gRPC server (npm run grpc:server).
GRPC_EXTERNAL=false
# Default: persistent local JSON storage. MongoDB is used when this is set.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=api_practicals
DATA_FILE=./data/database.json
